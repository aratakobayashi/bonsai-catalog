{
  "buildCommand": "rm -rf .next && npm run build",
  "headers": [
    {
      "source": "/images/articles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-rakuten",
      "schedule": "0 19 * * *"
    }
  ]
}

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# WordPress API Configuration
WORDPRESS_API_URL=https://bonsai-guidebook.net/wp-json/wp/v2
NEXT_PUBLIC_SITE_URL=https://bonsai-collection.com
# 管理画面ログイン用パスワード（未設定なら管理画面ログインは無効）
ADMIN_PASSWORD=
# セッション署名用の秘密鍵（任意。未設定なら ADMIN_PASSWORD を使用）
ADMIN_SESSION_SECRET=
# お問い合わせの送信先メールアドレス（未設定ならフォームは受付停止）
NEXT_PUBLIC_CONTACT_EMAIL=
